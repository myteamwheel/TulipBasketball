{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd recovered-app && npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "cd recovered-app/.next/standalone && HOSTNAME=0.0.0.0 node server.js",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
