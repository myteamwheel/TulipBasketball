// Dynasty Boys - Live KTC Market Dashboard
// Data model. History tables (KtcObservation, RosterSnapshot, Transaction,
// RefreshRun) are append-only by convention — application code must never
// UPDATE or DELETE rows in those tables, only INSERT.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// League / roster source of truth (mirrors Sleeper)
// ---------------------------------------------------------------------------

model League {
  id          String   @id @default(cuid())
  sleeperId   String   @unique
  name        String
  season      String
  format      String
  settings    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managers     Manager[]
  transactions Transaction[]
  refreshRuns  RefreshRun[]
}

model Manager {
  id               String   @id @default(cuid())
  league           League   @relation(fields: [leagueId], references: [id])
  leagueId         String
  sleeperUserId    String
  sleeperRosterId  Int
  displayName      String
  teamName         String?
  isPrimaryTeam    Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownershipIntervals OwnershipInterval[]
  rosterSnapshots    RosterSnapshot[]

  @@unique([leagueId, sleeperRosterId])
  @@index([leagueId, sleeperUserId])
}

// ---------------------------------------------------------------------------
// Players — canonical identity + Sleeper <-> KTC mapping
// ---------------------------------------------------------------------------

enum MappingStatus {
  MAPPED
  NEEDS_REVIEW
  UNMAPPED
}

model Player {
  id              String        @id @default(cuid())
  sleeperId       String        @unique
  ktcId           String?       @unique
  fullName        String
  normalizedName  String
  position        String
  nflTeam         String?
  status          String?
  mappingStatus   MappingStatus @default(NEEDS_REVIEW)
  mappingNote     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ktcObservations       KtcObservation[]
  marketObservations    MarketObservation[]
  consensusObservations ConsensusObservation[]
  ownershipIntervals    OwnershipInterval[]
  rosterSnapshots       RosterSnapshot[]
  signals               Signal[]
  notes                 UserNote[]

  @@index([normalizedName])
  @@index([position])
}

// ---------------------------------------------------------------------------
// Ownership — time-aware, separate from a player's value history
// ---------------------------------------------------------------------------

model OwnershipInterval {
  id                    String    @id @default(cuid())
  player                Player    @relation(fields: [playerId], references: [id])
  playerId              String
  manager               Manager   @relation(fields: [managerId], references: [id])
  managerId             String
  validFrom             DateTime
  validTo               DateTime?
  sourceTransactionId   String?
  createdAt             DateTime  @default(now())

  @@index([playerId, validFrom])
  @@index([managerId, validFrom])
}

enum RosterSlot {
  STARTER
  BENCH
  TAXI
  IR
}

model RosterSnapshot {
  id            String     @id @default(cuid())
  refreshRun    RefreshRun @relation(fields: [refreshRunId], references: [id])
  refreshRunId  String
  manager       Manager    @relation(fields: [managerId], references: [id])
  managerId     String
  player        Player     @relation(fields: [playerId], references: [id])
  playerId      String
  slot          RosterSlot
  observedAt    DateTime

  @@index([refreshRunId, managerId])
  @@index([playerId, observedAt])
}

// ---------------------------------------------------------------------------
// KTC market value observations — append-only
// ---------------------------------------------------------------------------

enum KtcSourceType {
  SEED_BASELINE
  MANUAL_CSV
  MANUAL_JSON
  AUTO_SCRAPE
}

enum ValidationStatus {
  VALID
  FLAGGED
  REJECTED
}

model KtcObservation {
  id                String            @id @default(cuid())
  player            Player            @relation(fields: [playerId], references: [id])
  playerId          String
  value             Int
  format            String            @default("SF-0.5PPR-noTEP")
  observedAt        DateTime
  sourceType        KtcSourceType
  sourceUrl         String?
  importBatchId     String?
  refreshRunId      String?
  validationStatus  ValidationStatus  @default(VALID)
  validationNote    String?
  createdAt         DateTime          @default(now())

  @@index([playerId, observedAt])
  @@index([importBatchId])
}

// ---------------------------------------------------------------------------
// Multi-source dynasty market observations + weighted consensus
// ---------------------------------------------------------------------------

enum MarketSource {
  KTC
  FANTASYCALC
  STATSGUY
  DYNASTYDEALER
  TRADYR
}

model MarketObservation {
  id               String       @id @default(cuid())
  player           Player       @relation(fields: [playerId], references: [id])
  playerId         String
  source           MarketSource
  rawValue         Int
  normalizedValue  Int
  observedAt       DateTime
  sourceUpdatedAt  DateTime?
  sourceUrl        String
  refreshRunId     String?
  sourceRank       Int?
  positionRank     Int?
  metadata         String?
  createdAt        DateTime     @default(now())

  @@index([playerId, source, observedAt])
  @@index([source, observedAt])
  @@index([refreshRunId])
}

model ConsensusObservation {
  id            String   @id @default(cuid())
  player        Player   @relation(fields: [playerId], references: [id])
  playerId      String
  value         Int
  observedAt    DateTime
  refreshRunId  String
  sourcesUsed   String
  sourceCount   Int
  weights       String
  createdAt     DateTime @default(now())

  @@unique([playerId, refreshRunId])
  @@index([playerId, observedAt])
  @@index([refreshRunId])
}

model DraftPickObservation {
  id              String   @id @default(cuid())
  season          Int
  round           Int
  bucket          String
  label           String
  value           Int
  observedAt      DateTime
  sourceUpdatedAt DateTime?
  sourceUrl       String
  refreshRunId    String?
  createdAt       DateTime @default(now())

  @@unique([season, round, bucket, refreshRunId])
  @@index([season, round, bucket, observedAt])
  @@index([refreshRunId])
}

// ---------------------------------------------------------------------------
// Transactions — chronological Sleeper league events
// ---------------------------------------------------------------------------

model Transaction {
  id                   String   @id @default(cuid())
  league               League   @relation(fields: [leagueId], references: [id])
  leagueId             String
  sleeperTransactionId String   @unique
  type                 String
  status               String
  sleeperCreatedAt     DateTime
  rosterIdsInvolved    String
  adds                 String?
  drops                String?
  draftPicks           String?
  waiverBudget         String?
  rawPayload           String
  processedAt          DateTime @default(now())

  @@index([leagueId, sleeperCreatedAt])
}

// ---------------------------------------------------------------------------
// Refresh runs, signals, notes
// ---------------------------------------------------------------------------

model RefreshRun {
  id                    String   @id @default(cuid())
  league                League   @relation(fields: [leagueId], references: [id])
  leagueId              String
  startedAt             DateTime @default(now())
  finishedAt            DateTime?
  status                String
  requestedSources      String
  sleeperSyncOk         Boolean?
  ktcSyncOk             Boolean?
  rosterChangesCount    Int      @default(0)
  playersRefreshed      Int      @default(0)
  mappingWarnings       String?
  errors                String?
  summary               String?

  rosterSnapshots RosterSnapshot[]

  @@index([leagueId, startedAt])
  @@index([status, startedAt])
}

enum SignalType {
  SELL_HIGH
  HOLD
  BUY_LOW
  CUT_BAIT
  WATCH
  CUT_LOSSES
}

model Signal {
  id           String     @id @default(cuid())
  player       Player     @relation(fields: [playerId], references: [id])
  playerId     String
  refreshRunId String?
  signal       SignalType
  score        Int
  confidence   String
  reasonCodes  String
  createdAt    DateTime   @default(now())

  @@index([playerId, createdAt])
  @@index([signal, createdAt])
  @@index([refreshRunId])
}

model UserNote {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String
  body      String
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId, createdAt])
}
